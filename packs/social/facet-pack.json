{
  "name": "@xibodev/facet-pack-social",
  "version": "1.0.0",
  "description": "Short-form vertical video, viral clips, podcast repurposing, and caption burn-in pipeline.",
  "kind": "content",
  "requirements": {
    "probes": ["facet.probe.ffmpeg.v1"]
  },
  "declarations": {
    "suggestedTools": ["media_probe", "scene_detect", "edit", "subtitle_burn", "audio_mix", "output_review"],
    "networkIntent": "none",
    "filesystemIntent": "project-local"
  },
  "exports": {
    "skills": [
      {
        "id": "social",
        "path": "SKILL.md",
        "description": "Entry skill for producing short-form vertical clips and repurposed content"
      }
    ],
    "pipelines": [
      {
        "id": "clip-factory",
        "path": "pipelines/clip-factory.yaml"
      },
      {
        "id": "podcast-repurpose",
        "path": "pipelines/podcast-repurpose.yaml"
      }
    ]
  }
}
