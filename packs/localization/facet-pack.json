{
  "name": "@xibodev/facet-pack-localization",
  "version": "1.0.0",
  "description": "Multilingual dubbing, subtitle translation, and voice localization pipeline.",
  "kind": "content",
  "requirements": {
    "probes": ["facet.probe.ffmpeg.v1"]
  },
  "declarations": {
    "suggestedTools": ["edgetts", "media_probe", "edit", "subtitle_burn", "audio_mix", "output_review"],
    "networkIntent": "none",
    "filesystemIntent": "project-local"
  },
  "exports": {
    "skills": [
      {
        "id": "localization",
        "path": "SKILL.md",
        "description": "Entry skill for video localization, dubbing, and translated subtitles"
      }
    ],
    "pipelines": [
      {
        "id": "localization-dub",
        "path": "pipelines/localization-dub.yaml"
      }
    ]
  }
}
