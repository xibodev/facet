+func runDerivatives(args []string, output io.Writer) error {
+	flags := newFlagSet("derivatives")
+	root := flags.String("root", ".", "bundle root")
+	requestPath := flags.String("request", "", "derivative request JSON")
+	outputPath := flags.String("output", "", "derivative plan JSON")
+	if err := parseFlags(flags, args); err != nil {
+		return err
+	}
+	if *requestPath == "" || *outputPath == "" {
+		return errors.New("derivatives requires --request and --output")
+	}
+	loaded, err := config.Load(*root)
+	if err != nil {
+		return err
+	}
+	request, err := media.ReadDerivativeRequest(*requestPath)
+	if err != nil {
+		return err
+	}
+	profiles := map[string]bool{}
+	for id := range loaded.Bundle.Profiles {
+		profiles[id] = true
+	}
+	plan, err := media.PlanDerivatives(request, profiles)
+	if err != nil {
+		return err
+	}
+	if err := writeReport(*outputPath, plan); err != nil {
+		return err
+	}
+	return writeJSON(output, response{OK: true, Command: "derivatives", Data: plan})
+}
+
+func runSource(args []string, output io.Writer) error {
+	flags := newFlagSet("source")
+	root := flags.String("root", ".", "bundle root")
+	requestPath := flags.String("request", "", "source request JSON")
+	outputDirectory := flags.String("output", "", "output directory")
+	if err := parseFlags(flags, args); err != nil {
+		return err
+	}
+	if *requestPath == "" || *outputDirectory == "" {
+		return errors.New("source requires --request and --output")
+	}
+	loaded, err := config.Load(*root)
+	if err != nil {
+		return err
+	}
+	ffprobe := environment.Inspect(loaded, "ffprobe")
+	if !ffprobe.Ready {
+		return fmt.Errorf("source dependency is not ready: ffprobe=%s", ffprobe.Status)
+	}
+	request, err := media.ReadSourceRequest(*requestPath)
+	if err != nil {
+		return err
+	}
+	directory, err := prepareOutputDirectory(*outputDirectory)
+	if err != nil {
+		return err
+	}
+	paths, metadata, err := media.IngestSource(context.Background(), ffprobe.Resolved, directory, request)
+	if err != nil {
+		return err
+	}
+	return writeJSON(output, response{OK: true, Command: "source", Data: map[string]any{"outputs": paths, "metadata": metadata}})
+}
