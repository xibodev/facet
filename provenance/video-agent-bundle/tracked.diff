+func verifyNodeModules(nodePath, workingDirectory string, modules []string) error {
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	arguments := make([]string, len(modules))
+	for index, module := range modules {
+		arguments[index] = fmt.Sprintf("require.resolve(%q)", module)
+	}
+	command := exec.CommandContext(ctx, nodePath, "-e", strings.Join(arguments, ";"))
+	command.Dir = workingDirectory
+	output, err := command.CombinedOutput()
+	if err != nil {
+		return fmt.Errorf("resolve renderer modules: %w: %s", err, firstLine(string(output)))
+	}
+	return nil
+}
